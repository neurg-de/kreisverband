<?xml version="1.0"?>
<ruleset name="Neurg Kreisverband">
    <description>Coding standards for the Neurg Kreisverband WordPress theme.</description>

    <!-- Scan theme directory -->
    <file>./theme</file>

    <!-- Exclude dev-only files from strict checks -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/lib/js/*.min.js</exclude-pattern>
    <!-- PHPCS 3 mis-tokenizes modern JavaScript operators/template literals in
         the generator. Check all JS with make js-check and browser smoke tests. -->
    <exclude-pattern>*/lib/js/kreiskarte-generator.js</exclude-pattern>

    <!-- Sass compiler outputs are minified and PHPCS cannot tokenize them.
         Their source is validated by npm run build / make zip in CI. -->
    <exclude-pattern>*/lib/css/editor.css</exclude-pattern>
    <exclude-pattern>*/lib/css/kreiskarte-generator.css</exclude-pattern>
    <exclude-pattern>*/lib/css/main.css</exclude-pattern>

    <!-- WordPress coding standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <!-- Allow arrow functions -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    </rule>

    <!-- Use WordPress-Extra for stricter checks -->
    <rule ref="WordPress-Extra"/>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- These static HTML partials deliberately contain no PHP. PHPCS emits
         this parser warning only when short_open_tag is disabled (as in CI).
         Keep all actual coding/security rules enabled for the same files. -->
    <rule ref="Internal.NoCodeFound">
        <exclude-pattern>*/template-parts/kitchen-sink/*.php</exclude-pattern>
    </rule>

    <!-- Set text domain -->
    <config name="text_domain" value="neurg-kreisverband"/>
    <config name="minimum_wp_version" value="6.4"/>
</ruleset>
